{{#> layout title="Your Mensa order has shipped"}}
  <p style="margin:0 0 8px 0;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#8A7C70;">
    Order {{orderNumber}}
  </p>
  <h1 style="margin:0 0 16px 0;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400;font-size:32px;line-height:1.2;color:#1A1410;">
    On its way, {{customerName}}.
  </h1>
  <p style="margin:0 0 24px 0;font-size:15px;line-height:1.6;color:#4F433B;">
    Your order has left our studio and is heading your way.
  </p>

  {{#if trackingCode}}
    <p style="margin:0 0 8px 0;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#8A7C70;">
      Tracking
    </p>
    <p style="margin:0 0 24px 0;font-size:14px;line-height:1.6;color:#1A1410;">
      {{trackingCode}}
    </p>
  {{/if}}

  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:8px 0 24px 0;">
    <tr>
      <td style="background:#FE718E;">
        <a href="{{trackingUrl}}" style="display:inline-block;padding:14px 28px;font-size:14px;font-weight:600;color:#FFFCF6;text-decoration:none;letter-spacing:0.02em;">Track your order</a>
      </td>
    </tr>
  </table>

  <p style="margin:0;font-size:13px;line-height:1.6;color:#8A7C70;">
    Questions about delivery? Just reply to this email and we will help.
  </p>
{{/layout}}

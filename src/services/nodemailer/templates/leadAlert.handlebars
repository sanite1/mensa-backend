{{#> layout title="New starter set lead"}}
  <p style="margin:0 0 8px 0;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#8A7C70;">
    Starter set finder · {{submittedAt}}
  </p>
  <h1 style="margin:0 0 16px 0;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400;font-size:28px;line-height:1.2;color:#1A1410;">
    {{name}} just found their starter set.
  </h1>
  <p style="margin:0 0 24px 0;font-size:14px;line-height:1.6;color:#4F433B;">
    They completed the quiz and saw their recommendation. If no order follows in a few days, this is your cue to follow up.
  </p>

  <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;margin:0 0 24px 0;border-collapse:collapse;">
    <tr>
      <td style="padding:6px 0;color:#8A7C70;text-transform:uppercase;letter-spacing:0.08em;font-size:11px;width:130px;vertical-align:top;">Name</td>
      <td style="padding:6px 0;color:#1A1410;font-size:14px;">{{name}}</td>
    </tr>
    <tr>
      <td style="padding:6px 0;color:#8A7C70;text-transform:uppercase;letter-spacing:0.08em;font-size:11px;vertical-align:top;">Email</td>
      <td style="padding:6px 0;color:#1A1410;font-size:14px;"><a href="mailto:{{email}}" style="color:#1A1410;">{{email}}</a></td>
    </tr>
    <tr>
      <td style="padding:6px 0;color:#8A7C70;text-transform:uppercase;letter-spacing:0.08em;font-size:11px;vertical-align:top;">Recommended</td>
      <td style="padding:6px 0;color:#1A1410;font-size:14px;font-weight:600;">{{resultName}}</td>
    </tr>
  </table>

  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0;">
    <tr>
      <td style="background:#FE718E;border-radius:4px;">
        <a href="{{adminLeadsUrl}}"
           style="display:inline-block;padding:12px 24px;font-family:Helvetica,Arial,sans-serif;font-size:14px;font-weight:600;color:#FFFCF6;text-decoration:none;">
          Open the leads tab
        </a>
      </td>
    </tr>
  </table>

  <p style="margin:24px 0 0 0;font-size:13px;line-height:1.6;color:#8A7C70;">
    Reply directly to this email to reach them, their address is set as Reply-To.
  </p>
{{/layout}}

{{#> layout title="Your Mensa invoice"}}
  <p style="margin:0 0 8px 0;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#8A7C70;">
    Invoice {{invoiceNumber}}
  </p>
  <h1 style="margin:0 0 16px 0;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400;font-size:32px;line-height:1.2;color:#1A1410;">
    Hello {{customerName}}, here is your invoice.
  </h1>
  <p style="margin:0 0 24px 0;font-size:15px;line-height:1.6;color:#4F433B;">
    {{#if dueDate}}It is due by {{dueDate}}. {{/if}}Open the link below to see the full breakdown, pay securely online, or download a copy for your records.
  </p>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
         style="width:100%;border-collapse:collapse;border-spacing:0;margin:0 0 24px 0;border-top:1px solid #E7DCCC;">
    {{#each lines}}
      <tr>
        <td valign="top" align="left" width="70%"
            style="width:70%;padding:12px 12px 12px 0;border-bottom:1px solid #F1E8DA;font-family:Helvetica,Arial,sans-serif;font-size:14px;color:#1A1410;vertical-align:top;text-align:left;">
          <div style="font-weight:600;line-height:1.3;">{{description}}</div>
          {{#if variantLabel}}
            <div style="margin-top:4px;font-size:13px;color:#8A7C70;line-height:1.3;">{{variantLabel}}</div>
          {{/if}}
          <div style="margin-top:4px;font-size:13px;color:#8A7C70;line-height:1.3;">Qty {{qty}}</div>
        </td>
        <td valign="top" align="right" width="30%"
            style="width:30%;padding:12px 0 12px 12px;border-bottom:1px solid #F1E8DA;font-family:Helvetica,Arial,sans-serif;font-size:14px;color:#1A1410;vertical-align:top;text-align:right;white-space:nowrap;">
          {{lineTotal}}
        </td>
      </tr>
    {{/each}}
  </table>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
         style="width:100%;border-collapse:collapse;border-spacing:0;margin:0 0 28px 0;">
    <tr>
      <td align="left" width="70%" style="width:70%;padding:8px 0 0 0;border-top:1px solid #E7DCCC;font-family:Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;color:#1A1410;text-align:left;">Total due</td>
      <td align="right" width="30%" style="width:30%;padding:8px 0 0 0;border-top:1px solid #E7DCCC;font-family:Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;color:#1A1410;text-align:right;white-space:nowrap;">{{total}}</td>
    </tr>
  </table>

  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0;">
    <tr>
      <td style="background:#FE718E;border-radius:4px;">
        <a href="{{invoiceUrl}}"
           style="display:inline-block;padding:12px 24px;font-family:Helvetica,Arial,sans-serif;font-size:14px;font-weight:600;color:#FFFCF6;text-decoration:none;">
          View and pay invoice
        </a>
      </td>
    </tr>
  </table>

  <p style="margin:24px 0 0 0;font-size:13px;line-height:1.6;color:#8A7C70;">
    Questions about this invoice? Reply to this email and we will help.
  </p>
{{/layout}}

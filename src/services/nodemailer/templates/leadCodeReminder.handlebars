{{#> layout title="Your 10% code is about to end"}}
  <p style="margin:0 0 8px 0;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#8A7C70;">
    A quick reminder
  </p>
  <h1 style="margin:0 0 16px 0;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400;font-size:32px;line-height:1.2;color:#1A1410;">
    {{customerName}}, your 10% code ends in {{daysLeft}} {{dayWord}}.
  </h1>
  <p style="margin:0 0 20px 0;font-size:15px;line-height:1.6;color:#4F433B;">
    Your starter set, the {{resultName}}, is still waiting. Use the code below at checkout before {{expiresOn}} and it takes 10% off.
  </p>

  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 24px 0;">
    <tr>
      <td style="border:1px dashed #FE718E;background:#FFF1F4;padding:14px 22px;font-family:'DM Mono','Courier New',monospace;font-size:22px;letter-spacing:0.12em;color:#1A1410;">
        {{code}}
      </td>
    </tr>
  </table>

  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0;">
    <tr>
      <td style="background:#FE718E;border-radius:4px;">
        <a href="{{shopUrl}}"
           style="display:inline-block;padding:12px 24px;font-family:Helvetica,Arial,sans-serif;font-size:14px;font-weight:600;color:#FFFCF6;text-decoration:none;">
          Shop your starter set
        </a>
      </td>
    </tr>
  </table>

  <p style="margin:24px 0 0 0;font-size:13px;line-height:1.6;color:#8A7C70;">
    Already ordered? Thank you, please ignore this email.
  </p>
{{/layout}}

{{#> layout title="Reset your Mensa password"}}
  <h1 style="margin:0 0 16px 0;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400;font-size:28px;line-height:1.2;color:#1A1410;">
    Hi {{name}},
  </h1>
  <p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4F433B;">
    We received a request to reset the password on your Mensa account. Use the button below within the next {{expiresInMinutes}} minutes.
  </p>
  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0;">
    <tr>
      <td style="background:#1A1410;">
        <a href="{{resetUrl}}" style="display:inline-block;padding:14px 28px;font-size:14px;font-weight:600;color:#FFFCF6;text-decoration:none;letter-spacing:0.02em;">Reset password</a>
      </td>
    </tr>
  </table>
  <p style="margin:0 0 8px 0;font-size:13px;line-height:1.6;color:#8A7C70;">
    If the button doesn't work, paste this link into your browser:
  </p>
  <p style="margin:0 0 24px 0;font-size:12px;line-height:1.5;word-break:break-all;color:#4F433B;">
    {{resetUrl}}
  </p>
  <p style="margin:0;font-size:13px;line-height:1.6;color:#8A7C70;">
    If you didn't request this, you can safely ignore this email. Your password won't change.
  </p>
{{/layout}}

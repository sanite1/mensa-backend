{{!--
  Shared email layout. Every transactional template should invoke this:

    {{#> layout title="Welcome to Mensa"}}
      ...email body markup here...
    {{/layout}}

  Inside this file, the body is rendered via {{> @partial-block}}.
  When the brand logo URL changes, edit it here once and every template
  inherits the update.
--}}<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
  </head>
  <body style="margin:0;padding:0;background:#F6EFE4;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#1A1410;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F6EFE4;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;background:#FFFCF6;border:1px solid #E7DCCC;">
            <tr>
              <td style="padding:32px 40px 24px 40px;border-bottom:1px solid #E7DCCC;">
                <img
                  src="https://res.cloudinary.com/dv4uk8qqc/image/upload/v1779977841/mensa_logo_xj80cy.png"
                  alt="Mensa Period Products"
                  width="140"
                  style="display:block;height:auto;border:0;outline:none;text-decoration:none;"
                />
              </td>
            </tr>
            <tr>
              <td style="padding:40px;">
                {{> @partial-block}}
              </td>
            </tr>
            <tr>
              <td style="padding:24px 40px;border-top:1px solid #E7DCCC;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:#8A7C70;">
                Mensa Period Products · Abuja, Nigeria
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

{{#> layout title="New contact message"}}
  <h1 style="margin:0 0 16px 0;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400;font-size:28px;line-height:1.2;color:#1A1410;">
    {{topic}} from {{name}}
  </h1>
  <p style="margin:0 0 24px 0;font-size:13px;line-height:1.6;color:#8A7C70;">
    Received {{receivedAt}}.
  </p>

  <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;margin:0 0 24px 0;border-collapse:collapse;">
    <tr>
      <td style="padding:6px 0;color:#8A7C70;text-transform:uppercase;letter-spacing:0.08em;font-size:11px;width:120px;vertical-align:top;">Name</td>
      <td style="padding:6px 0;color:#1A1410;font-size:14px;">{{name}}</td>
    </tr>
    <tr>
      <td style="padding:6px 0;color:#8A7C70;text-transform:uppercase;letter-spacing:0.08em;font-size:11px;vertical-align:top;">Email</td>
      <td style="padding:6px 0;color:#1A1410;font-size:14px;"><a href="mailto:{{email}}" style="color:#1A1410;">{{email}}</a></td>
    </tr>
    {{#if orderNumber}}
    <tr>
      <td style="padding:6px 0;color:#8A7C70;text-transform:uppercase;letter-spacing:0.08em;font-size:11px;vertical-align:top;">Order</td>
      <td style="padding:6px 0;color:#1A1410;font-family:'DM Mono','Courier New',monospace;font-size:13px;">{{orderNumber}}</td>
    </tr>
    {{/if}}
    <tr>
      <td style="padding:6px 0;color:#8A7C70;text-transform:uppercase;letter-spacing:0.08em;font-size:11px;vertical-align:top;">Topic</td>
      <td style="padding:6px 0;color:#1A1410;font-size:14px;">{{topic}}</td>
    </tr>
  </table>

  <div style="padding:18px 20px;background:#F6EFE4;border-left:3px solid #FE718E;color:#1A1410;font-size:15px;line-height:1.55;white-space:pre-wrap;">{{message}}</div>

  <p style="margin:24px 0 0 0;font-size:13px;line-height:1.6;color:#8A7C70;">
    Reply directly to this email — the visitor's address is set as Reply-To.
  </p>
{{/layout}}

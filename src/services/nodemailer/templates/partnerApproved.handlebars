{{#> layout title="Welcome to the Mensa partner programme"}}
  <h1 style="margin:0 0 16px 0;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400;font-size:30px;line-height:1.2;color:#1A1410;">
    You are in, {{name}}.
  </h1>
  <p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4F433B;">
    Welcome to the Mensa partner programme. You will earn a {{commissionRate}}% commission on every paid order that comes in through your referral link, payable to you once the order ships out and lands with the customer.
  </p>
  <p style="margin:0 0 24px 0;font-size:15px;line-height:1.6;color:#4F433B;">
    To finish setting things up, choose a password, share your bank details, and pick the referral code you would like to use. The link below is good for the next {{expiresInDays}} days.
  </p>
  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:8px 0 24px 0;">
    <tr>
      <td style="background:#1A1410;">
        <a href="{{onboardingUrl}}" style="display:inline-block;padding:14px 28px;font-size:14px;font-weight:600;color:#FFFCF6;text-decoration:none;letter-spacing:0.02em;">Complete my registration</a>
      </td>
    </tr>
  </table>
  <p style="margin:0 0 8px 0;font-size:13px;line-height:1.6;color:#8A7C70;">
    If the button does not work, paste this link into your browser:
  </p>
  <p style="margin:0 0 24px 0;font-size:12px;line-height:1.5;word-break:break-all;color:#4F433B;">
    {{onboardingUrl}}
  </p>
  <p style="margin:0;font-size:13px;line-height:1.6;color:#8A7C70;">
    Questions? Reply to this email and our partnerships lead will be in touch.
  </p>
{{/layout}}

{{#> layout title="Welcome to Mensa"}}
  <h1 style="margin:0 0 16px 0;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400;font-size:32px;line-height:1.2;color:#1A1410;">
    Welcome, {{name}}.
  </h1>
  <p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4F433B;">
    We are so glad you are here. Mensa makes reusable period products designed for comfort, dignity, and the long run.
  </p>
  <p style="margin:0 0 24px 0;font-size:15px;line-height:1.6;color:#4F433B;">
    Switch once. Wear for five years.
  </p>
  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:8px 0 24px 0;">
    <tr>
      <td style="background:#FE718E;">
        <a href="{{platformUrl}}/shop" style="display:inline-block;padding:14px 28px;font-size:14px;font-weight:600;color:#FFFCF6;text-decoration:none;letter-spacing:0.02em;">Shop the collection</a>
      </td>
    </tr>
  </table>
  <p style="margin:0;font-size:13px;line-height:1.6;color:#8A7C70;">
    Questions? Just reply to this email. A real person will get back to you.
  </p>
{{/layout}}

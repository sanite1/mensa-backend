{{#> layout title="Your Mensa payment did not go through"}}
  <p style="margin:0 0 8px 0;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#8A7C70;">
    Order {{orderNumber}}
  </p>
  <h1 style="margin:0 0 16px 0;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400;font-size:32px;line-height:1.2;color:#1A1410;">
    Payment did not go through.
  </h1>
  <p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;color:#4F433B;">
    We were not able to confirm payment on your recent order. Nothing has been charged, and the items have been released back into stock.
  </p>
  <p style="margin:0 0 24px 0;font-size:15px;line-height:1.6;color:#4F433B;">
    You can try again from your cart whenever you are ready.
  </p>

  <table role="presentation" cellpadding="0" cellspacing="0" style="margin:8px 0 24px 0;">
    <tr>
      <td style="background:#FE718E;">
        <a href="{{retryUrl}}" style="display:inline-block;padding:14px 28px;font-size:14px;font-weight:600;color:#FFFCF6;text-decoration:none;letter-spacing:0.02em;">Return to checkout</a>
      </td>
    </tr>
  </table>

  <p style="margin:0;font-size:13px;line-height:1.6;color:#8A7C70;">
    If you think this is a mistake, reply to this email and we will help sort it out.
  </p>
{{/layout}}

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# macOS reserves port 5000 for AirPlay Receiver, so we use 4000.
PORT=4000

# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mensa?retryWrites=true&w=majority

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
# Cookie domain for refresh token. Leave blank in dev (host-only cookie on localhost).
# In prod set to `.mensaproducts.com` so platform + admin share the cookie.
REFRESH_COOKIE_DOMAIN=

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_PUBLIC_KEY=pk_test_
PAYSTACK_WEBHOOK_SECRET=

# ─── Sendbox ─────────────────────────────────────────────────────────────────
SENDBOX_API_KEY=

# ─── SMTP (Nodemailer) ───────────────────────────────────────────────────────
# Dev: personal Gmail + 16-char app password (NOT the account password).
# Generate one at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-personal@gmail.com
SMTP_PASSWORD=your_16_char_app_password
# Display-name override so recipients see "Mensa" instead of the raw gmail address.
SMTP_FROM=Mensa <your-personal@gmail.com>
# Where new-order alerts land. Falls back to SUPPORT_EMAIL, then SMTP_FROM.
ADMIN_NOTIFICATION_EMAIL=orders@mensaproducts.com

# ─── Frontend URLs ───────────────────────────────────────────────────────────
FRONTEND_PLATFORM_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:3002
# Comma separated list of origins allowed by CORS (no trailing slashes).
# Falls back to the two FRONTEND_*_URL values when unset.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://mensaproducts.com,https://www.mensaproducts.com,https://admin.mensaproducts.com,https://mensa-frontend.vercel.app

# ─── Seed admin (only used by `npm run seed:admin`) ──────────────────────────
SEED_ADMIN_EMAIL=admin@mensaproducts.com
SEED_ADMIN_PASSWORD=change_me_strong_password
SEED_ADMIN_NAME=Mensa Admin

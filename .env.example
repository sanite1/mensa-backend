# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mensa?retryWrites=true&w=majority

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_PUBLIC_KEY=pk_test_
PAYSTACK_WEBHOOK_SECRET=

# ─── Sendbox ─────────────────────────────────────────────────────────────────
SENDBOX_API_KEY=

# ─── SMTP (Nodemailer) ───────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=support@mensaproducts.com
SMTP_PASSWORD=

# ─── Frontend URLs ───────────────────────────────────────────────────────────
FRONTEND_PLATFORM_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:3002
